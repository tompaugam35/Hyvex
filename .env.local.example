# Copie ce fichier en .env.local et remplace les valeurs ci-dessous par tes vraies clés.

# Récupère ta clé sur https://console.anthropic.com (rubrique "API Keys").
ANTHROPIC_API_KEY=

# Récupère ces valeurs sur ton projet Supabase : Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Crée une application sur https://www.strava.com/settings/api
# ("Authorization Callback Domain" = localhost en dev).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Active le paywall (données floutées tant qu'il n'y a pas d'abonnement actif).
# À laisser vide tant que le paiement Stripe n'est pas branché.
NEXT_PUBLIC_PAYWALL_ACTIF=

# Stripe : clé secrète (Développeurs > Clés API) et clé de signature du webhook
# (Développeurs > Webhooks, endpoint https://<ton-site>/api/stripe/webhook).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix (price_…) des offres Starter pack (40 €/3 mois) et Pro (15 €/mois).
STRIPE_PRIX_STARTER=
STRIPE_PRIX_PRO=

# Supabase > Project Settings > API Keys : clé "service_role" (serveur uniquement,
# utilisée par le webhook Stripe pour enregistrer les abonnements).
SUPABASE_SERVICE_ROLE_KEY=
